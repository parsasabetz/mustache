{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "sortTailwindcss": {},
  "endOfLine": "lf",
  "checkIgnorePragma": true,
  "printWidth": 80,
  "sortPackageJson": true,
  "insertFinalNewline": true,
  "ignorePatterns": [
    ".gitignore",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "bun.lockb",
    "dist/**"
  ]
}