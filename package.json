{
  "name": "mustache",
  "displayName": "Mustache - Git Stash Indicator",
  "version": "0.1.0",
  "description": "Shows an indicator in the status bar when you have stashed git changes",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parsasabetz/mustache"
  },
  "publisher": "parsasabetz",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bunx tsc -p ./tsconfig.json",
    "watch": "bunx tsc -watch -p ./tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check"
  },
  "devDependencies": {
    "@types/node": "22.20",
    "@types/vscode": "^1.85.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "mustache.showStashes",
        "title": "Mustache: Show Stashed Changes"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "node": ">=22.20",
    "vscode": "^1.85.0"
  },
  "packageManager": "pnpm@11.0.0"
}
